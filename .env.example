# Copy to apps/web/.env.local (or run `vercel env pull`). Never commit real values.

# --- Supabase (auto-synced by the Vercel Marketplace integration) ---
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_URL_NON_POOLING=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Google OAuth (Supabase local auth provider; set in Supabase dashboard for prod)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Cloudflare Turnstile (test keys below always pass; replace in prod) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- AI (Vercel AI Gateway). Use the `dev` key locally, `prod` key on Vercel ---
AI_GATEWAY_API_KEY=
# Which gateway key this deployment uses: dev | prod. The spend governor only sums 'prod' rows.
AI_GATEWAY_KEY_NAME=dev
# 1 = deterministic fake AI (tests, e2e, offline dev). No network calls.
AI_FAKE=1
# Prod gateway budget in USD, used by the spend governor (Architecture §9.2).
AI_PROD_BUDGET_USD=25

# --- Speech-to-text (live/audio sources only) ---
ASSEMBLYAI_API_KEY=

# --- YouTube lectures (F10, ADR-017) ---
# YouTube Data API v3 key: checks a video (public, embeddable, length, language) before any AI.
YOUTUBE_API_KEY=
# Direct Google AI key (Gemini API): the transcriber never goes through the AI Gateway.
GOOGLE_GENERATIVE_AI_API_KEY=
# Google spend cap in USD: at 75 % new YouTube lectures are refused (intake_paused).
GOOGLE_AI_BUDGET_USD=10

# --- Vercel cron auth ---
CRON_SECRET=dev-cron-secret
